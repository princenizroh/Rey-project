  sequences:
  - npcName: 1
    dialog: Halo
  - npcName: 5
    dialog: '[Penelpon: Halo, Linda data dari peneliti sudah di kumpulkan semua]'
  - npcName: 1
    dialog: Iya pak sudah tinggal di masukkan ke database perusahaan
  - npcName: 5
    dialog: '[Penelpon: Hari ini tolong semuanya diselesaikan ya. Ini ada data terbaru yang baru ditemukan.]'
  - npcName: 0
    dialog: Ibu kemana
  - npcName: 5
    dialog: '[Choice A: Menangis keras | Choice B: Tidur]'
  - npcName: 0
    dialog: Ibu... Ibu kemana..
  - npcName: 5
    dialog: '[Penelpon: Suara apa itu?]'
  - npcName: 1
    dialog: Eh gak papa itu anak saya lagi rewel
  - npcName: 5
    dialog: '[Penelpon: Oh yasudah, bisa diselesaikan hari ini kan]'
  - npcName: 1
    dialog: Iya pak bisa
  - npcName: 0
    dialog: Aku langsung tidur saja
