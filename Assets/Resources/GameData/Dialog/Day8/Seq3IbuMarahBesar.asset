  sequences:
  - npcName: 1
    dialog: Apasih ibu lagi sibuk tau haduh berisik banget
  - npcName: 0
    dialog: Ibu kenapa marah
  - npcName: 0
    dialog: Rey cuman Lapar
  - npcName: 1
    dialog: Ibu jadi gila kalau kamu menangis terus terusa
  - npcName: 1
    dialog: Ibu hari ini gak makan
  - npcName: 1
    dialog: Gak mandi
  - npcName: 1
    dialog: Mencuci
  - npcName: 1
    dialog: Memasak
  - npcName: 1
    dialog: KAMU TAHU GAK SIH SEBERAPA SIBUKNYA IBU
  - npcName: 1
    dialog: "*Menangis*"
  - npcName: 1
    dialog: Ibu gak kuat nak ibu cape mengurus pekerjaan rumah, pekerjaan perusahaan, dan mengurus kamu
  - npcName: 1
    dialog: Ibu cape banget tau gak
  - npcName: 1
    dialog: "*Menangis*"
  - npcName: 0
    dialog: Ibu kenapa menangis
  - npcName: 1
    dialog: Sejak ngurus kamu dan kerja ini ibu jadi sering telat
  - npcName: 1
    dialog: Tetap tersenyum tapi tubuh ini tidak kuat sekali
  - npcName: 1
    dialog: Selama punya kamu, aku sangat menderita banget
  - npcName: 1
    dialog: Selalu cuci handuk karena kamu ngompolnya sangat deras
  - npcName: 1
    dialog: Sudah dikasih popok tapi masih tetap tembus kehanduk
  - npcName: 1
    dialog: Cape ibu harus gonta ganti handuk
  - npcName: 0
    dialog: Ibu maaf Rey merepotkan Ibu
  - npcName: 1
    dialog: Sangat aneh ibu curhat ke Rey
  - npcName: 1
    dialog: Udah seperti orang gila aja
  - npcName: 1
    dialog: Sekarang kepalaku pusing banget
  - npcName: 1
    dialog: Kamu segera tidur
  - npcName: 1
    dialog: Ibu harus bekerja
  - npcName: 1
    dialog: Tapi ibu makin tidak minat untuk bekerja
  - npcName: 1
    dialog: Perasaan ibu semakin tidak karuan
  - npcName: 0
