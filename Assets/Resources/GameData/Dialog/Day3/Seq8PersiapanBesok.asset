  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bc95e7fb1be8ad24795b8b55a4b44a68, type: 3}
  m_Name: Seq8PersiapanBesok
  m_EditorClassIdentifier: 
  sequences:
  - npcName: 2
    dialog: Masakan istriku memang enak seperti biasa
  - npcName: 1
    dialog: Biasa aja kali
  - npcName: 1
    dialog: Btw, besok aku mulai kerja lagi
  - npcName: 2
    dialog: Serius? Apa gak kurang lama cutinya
  - npcName: 1
    dialog: Iya, aku juga udah disuruh kerja lagi
  - npcName: 1
    dialog: Agak sulit mengambil cuti di bagian administrasi di perusahaan pembuatan fusi nuklir
  - npcName: 1
    dialog: Bisa bisa, kalau kelamaan ambil cuti nanti bisa dipecat
  - npcName: 2
    dialog: Emangnya gak ada mau niatan buat berhenti
  - npcName: 2
    dialog: Kan gaji udah cukup dari ayah di bagian teknisi pembuatan fusi nuklir
  - npcName: 1
    dialog: Gak mau, gini gini aku juga orang penting walaupun dibagian administrasi
  - npcName: 2
    dialog: Iya deh
  - npcName: 1
    dialog: Aku udah pikir-pikir
  - npcName: 1
    dialog: Rey harus pindah ke kamarnya sendiri
  - npcName: 2
    dialog: Yakin? Masih kecil banget
  - npcName: 1
    dialog: Aku gak bisa kerja sambil begadang terus, apalagi nanti Rey bisa kebrisikan
  - npcName: 1
    dialog: Lagian kamarnya udah siap kan
  - npcName: 2
    dialog: Iya sih... ya udah terserah kamu
  - npcName: 2
    dialog: Karena berhubungan dengan kesibukan kerja kamu, berarti kayaknya besok bakal pulang lambat
  - npcName: 1
    dialog: Hmm.. iya... Yang penting langsung pulang
