  sequences:
  - npcName: 2
    dialog: Linda sayang?
  - npcName: 2
    dialog: Rey! Sayang!
  - npcName: 2
    dialog: Ya ampun... kamu kenapa?
  - npcName: 2
    dialog: Mukamu pucat banget
  - npcName: 2
    dialog: Kapan terakhir minum susu?
  - npcName: 2
    dialog: Popoknya basah... udah berapa lama?
  - npcName: 2
    dialog: Mama kamu dimana sayang?
  - npcName: 2
    dialog: Sabar ya Rey
