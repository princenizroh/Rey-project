      dialogType: 1
      dialog3DLocation: 0
      camChoice: 0
      dialogEntry: "Ayah.. Ibu.."
      choices: []
    Animation:
      Coordinates: {x: 0, y: 0, z: 0}
  - Type: 0
    Dialog:
      dialogType: 1
      dialog3DLocation: 0
      camChoice: 0
      dialogEntry: "Lapar.."
      choices: []
    Animation:
      Coordinates: {x: 0, y: 0, z: 0}
  - Type: 0
    Dialog:
      dialogType: 1
      dialog3DLocation: 0
      camChoice: 0
      dialogEntry: "[Keadaan: Sang anak merasa lapar]"
      choices:
      - playerChoice: "Mengeluarkan suara \"Neh\" yang menandakan lapar"
