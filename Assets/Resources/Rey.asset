  - Type: 0
    Dialog:
      dialogType: 1
      dialog3DLocation: 0
      camChoice: 0
      dialogEntry: "Bidan: Ketika bayi sedang tidur, segeralah Ibu tidur istirahat yang cukup adalah obat terbaik untuk pemulihan Ibu"
